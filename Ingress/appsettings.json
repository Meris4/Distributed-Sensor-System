{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "ingest": {
        "ClusterId": "ingestion",
        "Match": { "Path": "/api/ingest/{**catch-all}" }
      },
      "sensors": {
        "ClusterId": "ingestion",
        "Match": { "Path": "/api/sensors/{**catch-all}" }
      },
      "alarms": {
        "ClusterId": "notification",
        "Match": { "Path": "/api/alarms/{**catch-all}" }
      }
    },
    "Clusters": {
      "ingestion": {
        "Destinations": {
          "d1": { "Address": "http://ingestion-service:8080" }
        }
      },
      "notification": {
        "Destinations": {
          "d1": { "Address": "http://notification-service:8080" }
        }
      }
    }
  }
}